# Execution mode. THE most consequential setting here.
#   mock (default) — commands return recorded fixture output. Nothing on this
#                    machine is touched, whatever the event feed says.
#   real           — commands run on this machine, each checked against the
#                    allowlist first. Use this on the Ubuntu VM.
# Mock and real runs look identical in the UI, so check GET /api/health or the
# startup banner if you are unsure which one is live.
# EXECUTOR=real


# Anthropic API key for the four runtime agents.
# Without it the engine falls back to its deterministic paths and the suite
# still runs; with it, Triage/Diagnostic/Security/Commander call Claude.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Runbook store. Defaults to ubuntu-26.04; set only to override.
# RUNBOOK_STORE=ubuntu-26.04

# Where this endpoint reports its tickets.
# Same machine (both apps local):   http://127.0.0.1:8001   (default)
# Monitoring on the Mac, agent on the Parallels VM:
#   MONITORING_URL=http://10.211.55.2:8001
# Find the Mac's address from the VM with:  ip route | awk '/default/ {print $3}'
# MONITORING_URL=http://127.0.0.1:8001

# Set to 0 to run the agent with no service desk at all (offline rehearsal).
# MONITORING_ENABLED=1

# Name this endpoint reports itself as. Defaults to the system hostname.
# ENDPOINT_HOSTNAME=ubuntu-vm-01

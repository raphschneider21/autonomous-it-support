# Final-demo profile. The launcher forces these values even if a developer's
# shell contains a model key or a previous real-executor setting.
DEMO_MODE=1
EXECUTOR=mock
AGENT_MODE=deterministic

# Execution mode. THE most consequential setting here.
#   mock (default) — CUPS commands share simulated state; other commands use
#                    fixtures. No command alters the host.
#   real           — commands run on this machine, each checked against the
#                    allowlist first. Requires DEMO_MODE=0 (development only).
# Mock and real runs look identical in the UI, so check GET /api/health or the
# startup banner if you are unsure which one is live.
# EXECUTOR=real  # development only; demo preflight rejects this


# Anthropic API key for the four runtime agents.
# Without it the engine falls back to its deterministic paths and the suite
# still runs. A key is ignored while DEMO_MODE=1 or AGENT_MODE=deterministic.
# Optional model development requires DEMO_MODE=0 and AGENT_MODE=auto/live.
# Get one at: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...  # optional development path only

# Runbook store. Defaults to ubuntu-26.04; set only to override.
# RUNBOOK_STORE=ubuntu-26.04

# Where this endpoint reports its tickets.
# Same machine (both apps local):   http://127.0.0.1:8001   (default)
# Monitoring on the Mac, agent on the Parallels VM:
#   MONITORING_URL=http://10.211.55.2:8001
# Find the Mac's address from the VM with:  ip route | awk '/default/ {print $3}'
# MONITORING_URL=http://127.0.0.1:8001

# Set to 0 to run the agent with no service desk at all (offline rehearsal).
MONITORING_ENABLED=1

# Demo mode uses ubuntu-demo-01 consistently in health, tickets and escalation.
# Outside demo mode these override the system hostname.
ENDPOINT_NAME=ubuntu-demo-01
ENDPOINT_HOSTNAME=ubuntu-demo-01
